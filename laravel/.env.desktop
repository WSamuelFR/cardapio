APP_NAME="AKY Lanches"
APP_ENV=production
APP_KEY=base64:4eOCTe2KYDmbUXw4AdkylTeQag2inhWLRi2XuTMcUo8=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8765

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=single
LOG_LEVEL=error

# Conexao Principal 100% Segura em SQLite Local (Zero senhas expostas)
DB_CONNECTION=sqlite
DB_DATABASE=database/backup/aky_backup.sqlite

# Servidor Remoto de Sincronizacao na Nuvem Hostinger
REMOTE_API_URL=https://akylanches.freedevs.tech

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

SQLITE_BACKUP_ENABLED=false
VITE_APP_NAME="${APP_NAME}"

